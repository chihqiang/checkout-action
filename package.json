{
  "name": "checkout-action",
  "version": "0.1.0",
  "description": "GitHub Action to clone any Git repository via HTTPS or SSH",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/ tests/",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'"
  },
  "keywords": ["github-action", "checkout", "clone", "git"],
  "author": "zhiqiang <zhiqiang2033@gmail.com>",
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.10.0",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.3",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@actions/core": "^1.10.0"
  }
}
